// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id                String    @id @default(cuid())
  patientName       String
  phoneNumber       String
  date              DateTime
  time              String
  status            String    @default("pending") // pending, confirmed, cancelled, completed
  notes             String?
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model BotSession {
  id        String   @id @default(cuid())
  phoneNumber String @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentAdminNumber {
  id          String   @id @default(cuid())
  phoneNumber String   @unique // Número WhatsApp autorizado para notificaciones/admin del bot de citas
  label       String?  // Nombre o referencia del administrador
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppointmentPattern {
  id          String   @id @default(cuid())
  pattern     String   // Patrón regex o texto a buscar
  description String   // Descripción del patrón
  priority    Int      @default(0) // Prioridad (mayor = más importante)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DateFormat {
  id          String   @id @default(cuid())
  format      String   // Formato de fecha (ej: "dd/MM/yyyy", "yyyy-MM-dd")
  pattern     String   // Patrón regex para reconocer el formato
  example     String   // Ejemplo de uso
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimeFormat {
  id          String   @id @default(cuid())
  format      String   // Formato de hora (ej: "HH:mm", "h:mm a")
  pattern     String   // Patrón regex para reconocer el formato
  example     String   // Ejemplo de uso
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotResponse {
  id          String   @id @default(cuid())
  trigger     String   // Palabra clave o patrón que activa esta respuesta
  response    String   // Texto de respuesta
  responseType String  @default("text") // text, help, error, success
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessHours {
  id                String   @id @default(cuid())
  startTime         String   @default("08:00") // Hora de inicio (formato HH:mm)
  endTime           String   @default("18:00") // Hora de fin (formato HH:mm)
  appointmentDuration Int    @default(60) // Duración de cada cita en minutos
  minCancellationNoticeHours Int @default(1) // Anticipación mínima para cancelar/reagendar
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  restPeriods       RestPeriod[] // Periodos de descanso
  nonWorkingDays    NonWorkingDay[] // Días no laborables
}

model RestPeriod {
  id            String   @id @default(cuid())
  businessHoursId String
  businessHours BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Cascade)
  startTime     String   // Hora de inicio del descanso (formato HH:mm)
  endTime       String   // Hora de fin del descanso (formato HH:mm)
  description   String?  // Descripción opcional del periodo
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NonWorkingDay {
  id            String   @id @default(cuid())
  businessHoursId String
  businessHours BusinessHours @relation(fields: [businessHoursId], references: [id], onDelete: Cascade)
  date          DateTime // Fecha no laborable
  description   String?  // Descripción opcional (ej: "Día festivo", "Vacaciones")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AppointmentWaitlistEntry {
  id          String   @id @default(cuid())
  patientName String
  phoneNumber String
  preferredDate DateTime?
  preferredTime String?
  notes       String?
  status      String   @default("active") // active, contacted, closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --- Bot de Mochilas (sesión y datos separados del bot de citas) ---

model BackpackBotSession {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackpackProduct {
  id          String   @id @default(cuid())
  name        String   // Nombre del producto
  description String   // Descripción para búsqueda y mostrar al usuario
  imageUrl    String?  // URL de la imagen (opcional)
  useType     String   // "school" | "work"
  gender      String   // "man" | "woman" | "unisex"
  price       Float    @default(0) // Precio del producto
  stock       Int      @default(0) // Cantidad en existencia
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Reglas e información del negocio para el bot de mochilas (una fila)
model BackpackBotPolicy {
  id                  String   @id @default("singleton")
  rulesForBot         String   @default("") // Instrucciones / límites (system prompt)
  customerFacts       String   @default("") // Horarios, ubicación, políticas (system prompt)
  interactionWorkflow String   @default("") // Flujo de trabajo documentado (system prompt + editable en admin)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BackpackAdminNumber {
  id          String   @id @default(cuid())
  phoneNumber String   @unique // Número WhatsApp autorizado para opciones administrativas
  label       String?  // Nombre o referencia del administrador
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BackpackSoldProductEntry {
  id               String            @id @default(cuid())
  adminPhoneNumber String
  message          String
  cashCutId        String?
  cashCut          BackpackCashCut?  @relation(fields: [cashCutId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model BackpackCashCut {
  id               String                     @id @default(cuid())
  adminPhoneNumber String
  entryCount       Int                        @default(0)
  result           String
  entries          BackpackSoldProductEntry[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
}
