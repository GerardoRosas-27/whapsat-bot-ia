// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id          String   @id @default(cuid())
  patientName String
  phoneNumber String
  date        DateTime
  time        String
  status      String   @default("pending") // pending, confirmed, cancelled, completed
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotSession {
  id        String   @id @default(cuid())
  phoneNumber String @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppointmentPattern {
  id          String   @id @default(cuid())
  pattern     String   // Patrón regex o texto a buscar
  description String   // Descripción del patrón
  priority    Int      @default(0) // Prioridad (mayor = más importante)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DateFormat {
  id          String   @id @default(cuid())
  format      String   // Formato de fecha (ej: "dd/MM/yyyy", "yyyy-MM-dd")
  pattern     String   // Patrón regex para reconocer el formato
  example     String   // Ejemplo de uso
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TimeFormat {
  id          String   @id @default(cuid())
  format      String   // Formato de hora (ej: "HH:mm", "h:mm a")
  pattern     String   // Patrón regex para reconocer el formato
  example     String   // Ejemplo de uso
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotResponse {
  id          String   @id @default(cuid())
  trigger     String   // Palabra clave o patrón que activa esta respuesta
  response    String   // Texto de respuesta
  responseType String  @default("text") // text, help, error, success
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
